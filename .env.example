# AgentOS Environment Configuration
# Copy this file to .env and insert your API keys

# OpenCode API Key (Get free key from https://opencode.ai)
OPENCODE_API_KEY=your_opencode_api_key_here

# Anthropic / OpenAI Base URLs (Routed via internal bridge on port 8000)
ANTHROPIC_BASE_URL=http://127.0.0.1:8000
OPENAI_API_BASE=http://127.0.0.1:8000/v1
